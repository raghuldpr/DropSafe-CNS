# Secrets for the Hugging Face Space (Settings > Variables and secrets). Never commit real values.
ENVIRONMENT=production
DEBUG=false
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Neon connection string, psycopg driver, SSL required
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
# Browser origin = your Pages URL (the proxy makes requests same-origin, this is a safety net)
ALLOWED_ORIGINS=https://your-project.pages.dev
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Ciphertext stored in Postgres (no card needed)
STORAGE_BACKEND=postgres
# Sepolia anchoring
AUDIT_ANCHOR_MODE=sepolia
BLOCKCHAIN_NETWORK=sepolia
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ANCHOR_CONTRACT_ADDRESS=0xYourDeployedContractAddress
# Funded Sepolia test wallet (see blockchain/scripts/new-wallet.ts). TEST WALLET ONLY.
ANCHOR_SIGNER_PRIVATE_KEY=0xYourTestWalletPrivateKey
EVM_SIGNER_PRIVATE_KEY=0xYourTestWalletPrivateKey
# Set to false after the first successful boot if you do not want demo accounts online
SEED_DEMO_DATA=true
