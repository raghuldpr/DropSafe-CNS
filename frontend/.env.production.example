# Cloudflare Pages build-time variables (Settings > Environment variables).
# Same-origin API: the Pages Function in functions/api forwards /api to the backend.
VITE_API_BASE_URL=/api/v1
# Public Sepolia RPC (browser reads the anchor contract directly)
VITE_BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_CHAIN_ID=11155111
# Address printed by the Sepolia deploy step
VITE_AUDIT_ANCHOR_CONTRACT_ADDRESS=0xYourDeployedContractAddress
