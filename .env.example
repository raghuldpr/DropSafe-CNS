# ==============================================================================
# DropSafe - Environment Configuration
# "Your Files. Your Control."
# ==============================================================================

# Application Settings
APP_NAME="DropSafe Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="insecure-change-this-in-production-super-secret-key-min-32-chars"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL with Psycopg 3)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="dropsafe"
POSTGRES_PASSWORD="dropsafe_secret"
POSTGRES_DB="dropsafe_db"
DATABASE_URL="postgresql+psycopg://dropsafe:dropsafe_secret@localhost:5432/dropsafe_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis Configuration (Caching, Task Queue & Rate Limiting)
REDIS_URL="redis://localhost:6379/0"

# Storage Settings (Cloudflare R2 / S3 / MinIO)
STORAGE_BACKEND="r2"
STORAGE_LOCAL_ROOT="./data/storage"
R2_ENDPOINT_URL="http://localhost:9000"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET_NAME="dropsafe-vault"
R2_REGION="auto"

# Cryptographic & Security Settings (Client-Side Encryption Envelope)
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Blockchain Audit Anchor Configuration
BLOCKCHAIN_NETWORK="sepolia"
BLOCKCHAIN_RPC_URL=""
AUDIT_BATCH_INTERVAL_SECONDS=300

# Logging Configuration
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=false
