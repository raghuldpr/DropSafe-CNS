  "cards": [
    {
      "dot": "cyan",
      "title": "Core Cryptographic Algorithms",
      "items": [
        "File Payload Cipher: AES-256-GCM authenticated symmetric encryption with 96-bit nonce and 128-bit authentication tag",
        "Key Encapsulation: RSA-OAEP-3072 (SHA-256 MGF1) wraps per-document Data Encryption Keys (DEKs) for each recipient",
        "Signatures & Authentication: ECDSA P-256 (secp256r1) with SHA-256 for file digests and attribute credentials; Argon2id for passwords"
      ]
    },
    {
      "dot": "emerald",
      "title": "Attribute-Based Access Control (ABAC)",
      "items": [
        "Recursive AST policy engine enforcing fine-grained default-deny rules (all, any, not, eq, in, contains, gte, lte)",
        "Attribute Authority issues ECDSA-P256 (ES256) cryptographically signed user credentials with canonical JSON",
        "Dynamic attribute revocation: Immediate revocation takes effect dynamically at file download evaluation time"
      ]
    },
    {
      "dot": "violet",
      "title": "Blockchain Audit Anchor & Merkle Proofs",
      "items": [
        "Domain-Separated Merkle Trees: Leaf hashes use SHA-256(0x00 || event_hash); internal nodes use SHA-256(0x01 || left || right)",
        "AuditAnchor.sol: Smart contract exposes anchorBatch(batchNumber, merkleRoot, firstSeq, lastSeq, count) and verifyBatchRoot()",
        "Dual-Mode Execution: OutboxWorker defaults to deterministic Mock Mode (simulated block 5000000+), ready for Web3 live Sepolia RPC"
      ]
    }
  ]
